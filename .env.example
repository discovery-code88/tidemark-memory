# Copy to .env and fill in. Never commit .env.
# Comma-separated API keys clients must send (Authorization: Token <key>, Bearer <key> or X-Api-Key).
TIDEMARK_API_KEYS=change-me
# Embeddings: an OpenAI-compatible endpoint (e.g. DashScope's compatible mode) and its key.
# Leave the key empty for the offline placeholder embeddings (development only).
# Other providers (Azure, Gemini, Cohere, Voyage, Jina, Ollama, TEI, custom JSON):
# set TIDEMARK_EMBED_PROTOCOL; see "Embedding providers" in the README.
# TIDEMARK_EMBED_PROTOCOL=openai
# Optional language model (any API: OpenAI-compatible, anthropic, gemini, custom, command); see the README.
# TIDEMARK_LLM_URL=
# TIDEMARK_LLM_API_KEY=
# TIDEMARK_LLM_MODEL=
# Preference memory: off (default), rules, or llm (needs the model above); search slots for preferences.
# TIDEMARK_PREFERENCES=off
# TIDEMARK_PREFERENCE_SLOTS=0
TIDEMARK_EMBED_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TIDEMARK_EMBED_API_KEY=
TIDEMARK_EMBED_MODEL=text-embedding-v4
